<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= property.propertyType %> à <%= city %>, <%= country %></title>
<meta name="description" content="<%= metaDescription %>">
<% if (keywords.length) { %><meta name="keywords" content="<%= keywords.join(', ') %>"><% } %>
<link rel="canonical" href="<%= fullUrl %>">

<meta property="og:type" content="website">
<meta property="og:title" content="<%= property.propertyType %> de <%= surface %> m² à <%= city %>">
<meta property="og:description" content="<%= metaDescription %>">
<meta property="og:url" content="<%= fullUrl %>">
<% if (photos.length) { %><meta property="og:image" content="<%= siteUrl %>/uploads/<%= photos[0] %>"><% } %>
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Instrument+Sans:wght@400;500;600&display=swap">
<link rel="stylesheet" href="<%= siteUrl %>/css/landing.css">

<script type="application/ld+json"><%- JSON.stringify(jsonLD) %></script>

<script>
(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','<%= gtmId %>');
</script>
</head>

<body class="theme-<%= theme %> layout-<%= layout %>">
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%= gtmId %>" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<% if (layout === 'video') { %>

<header class="hero hero--video">
  <div class="hero__video">
    <iframe src="<%= embedUrl %>" title="<%= t.videoHint %>" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
  </div>
  <div class="hero__veil"></div>
  <div class="hero__inner">
    <div class="hero__bar">
      <span class="brand brand--light">UAP IMMO</span>
    </div>
    <div class="hero__caption">
      <p class="eyebrow eyebrow--light"><%= property.propertyType %> · <%= city %>, <%= country %></p>
      <h1 class="display display--light"><%= t.propertyHeading %> <%= city %></h1>
      <ul class="chips chips--light">
        <li><%= surface %> m²</li>
        <% if (property.rooms) { %><li><%= property.rooms %> <%= t.roomsLabel %></li><% } %>
        <% if (property.bedrooms) { %><li><%= property.bedrooms %> <%= t.bedroomsLabel %></li><% } %>
        <% if (!dpePending) { %><li>DPE <%= dpe %></li><% } %>
      </ul>
      <div class="hero__actions">
        <p class="price price--light"><%= priceLabel %> €</p>
        <a class="btn btn--light" href="#contact"><%= t.visit %></a>
      </div>
    </div>
  </div>
</header>
<p class="scroll-hint"><%= t.scrollHint %></p>

<% } else { %>

<header class="topbar">
  <span class="brand">UAP IMMO</span>
  <nav class="topbar__nav">
    <a href="#description"><%= t.guidedTour %></a>
    <a href="#localisation"><%= t.location %></a>
    <a class="btn btn--ghost" href="#contact"><%= t.visit %></a>
  </nav>
</header>

<section class="gallery" aria-label="<%= t.photos %>">
  <% if (photos.length) { %>
    <figure class="gallery__main">
      <img src="/uploads/<%= photos[0] %>" alt="<%= property.propertyType %> de <%= surface %> m² à <%= city %>" width="1200" height="800">
    </figure>
    <div class="gallery__side">
      <% if (photos[1]) { %>
      <figure><img src="/uploads/<%= photos[1] %>" alt="<%= property.propertyType %> à <%= city %> — vue complémentaire" width="600" height="400" loading="lazy"></figure>
      <% } %>
      <% if (photos[2]) { %>
      <figure>
        <img src="/uploads/<%= photos[2] %>" alt="<%= property.propertyType %> à <%= city %> — vue complémentaire" width="600" height="400" loading="lazy">
        <% if (photos.length > 3) { %><figcaption>+ <%= photos.length - 3 %> <%= t.morePhotos %></figcaption><% } %>
      </figure>
      <% } %>
    </div>
  <% } %>
</section>

<% } %>

<main class="wrap">
  <div class="col-main">

    <% if (layout === 'photo') { %>
    <p class="eyebrow"><%= property.propertyType %></p>
    <h1 class="display"><%= t.propertyHeading %> <%= city %></h1>
    <p class="subtitle"><%= city %><% if (property.postalCode) { %> (<%= property.postalCode %>)<% } %>, <%= country %></p>

    <dl class="facts">
      <div><dt><%= t.surfaceUnit %></dt><dd><%= surface %></dd></div>
      <% if (property.rooms) { %><div><dt><%= t.roomsLabel %></dt><dd><%= property.rooms %></dd></div><% } %>
      <% if (property.bedrooms) { %><div><dt><%= t.bedroomsLabel %></dt><dd><%= property.bedrooms %></dd></div><% } %>
      <% if (property.yearBuilt) { %><div><dt><%= t.yearLabel %></dt><dd><%= property.yearBuilt %></dd></div><% } %>
    </dl>
    <% } %>

    <section id="description" class="block">
      <h2><%= t.guidedTour %></h2>
      <% if (property.description) { %>
        <% property.description.split(/\n+/).filter(Boolean).forEach(function (para) { %>
        <p><%= para %></p>
        <% }); %>
      <% } else { %>
        <p><%= t.noDescription %></p>
      <% } %>
    </section>

    <% if (layout === 'video' && photos.length) { %>
    <section class="block">
      <h2><%= t.photos %></h2>
      <div class="thumbs">
        <% photos.slice(0, 6).forEach(function (photo, i) { %>
        <figure><img src="/uploads/<%= photo %>" alt="<%= property.propertyType %> à <%= city %> — photo <%= i + 1 %>" width="400" height="300" loading="lazy"></figure>
        <% }); %>
      </div>
    </section>
    <% } %>

    <% if (features.length) { %>
    <section class="block">
      <h2><%= t.equipment %></h2>
      <ul class="features">
        <% features.forEach(function (label) { %><li><%= label %></li><% }); %>
      </ul>
    </section>
    <% } %>

    <section class="block">
      <h2><%= t.energy %></h2>
      <div class="dpe">
        <span class="dpe__letter<%= dpePending ? ' dpe__letter--pending' : '' %>"><%= dpePending ? '?' : dpe %></span>
        <p><%= dpePending ? t.inProgress : 'DPE ' + dpe %></p>
      </div>
    </section>

    <section id="localisation" class="block">
      <h2><%= t.location %></h2>
      <div id="map" class="map" data-city="<%= city %>" data-country="<%= country %>" data-postal="<%= property.postalCode || '' %>"></div>
      <p class="note"><%= t.addressNote %></p>
    </section>
  </div>

  <aside id="contact" class="col-aside">
    <div class="pricecard">
      <p class="pricecard__label"><%= t.price %></p>
      <p class="pricecard__price"><%= priceLabel %> €</p>
      <% if (pricePerSqm) { %><p class="pricecard__sub"><%= pricePerSqm %> € <%= t.pricePerSqm %></p><% } %>
      <% if (contactPhone) { %>
      <a class="btn btn--primary" href="tel:<%= contactPhone.replace(/\s/g, '') %>"><%= t.visit %></a>
      <% } %>
      <% if (contactName) { %>
      <div class="agent">
        <span class="agent__avatar"><%= initials %></span>
        <div>
          <p class="agent__name"><%= contactName %></p>
          <% if (contactPhone) { %><a href="tel:<%= contactPhone.replace(/\s/g, '') %>"><%= contactPhone %></a><% } %>
        </div>
      </div>
      <% } %>
    </div>
  </aside>
</main>

<% if (contactPhone) { %>
<div class="actionbar">
  <div>
    <p class="actionbar__label"><%= t.price %></p>
    <p class="actionbar__price"><%= priceLabel %> €</p>
  </div>
  <a class="btn btn--primary" href="tel:<%= contactPhone.replace(/\s/g, '') %>"><%= t.visit %></a>
</div>
<% } %>

<footer class="footer">
  <span><%= t.publishedBy %></span>
  <nav>
    <a href="<%= siteUrl %>/mentions-legales"><%= t.legal %></a>
    <a href="<%= siteUrl %>/cgu"><%= t.terms %></a>
  </nav>
</footer>

<script src="<%= siteUrl %>/js/landing.js" defer></script>
</body>
</html>
